{
  "name": "claudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable": "node scripts/build-portable.mjs",
    "i18n": "node scripts/i18n.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test && playwright test -c playwright.pwa.config.js",
    "test:pwa": "playwright test -c playwright.pwa.config.js",
    "test:quiet": "vitest run --reporter=dot && playwright test --reporter=dot && playwright test -c playwright.pwa.config.js --reporter=dot",
    "test:perf": "playwright test -c playwright.perf.config.js"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "qrcode-generator": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
